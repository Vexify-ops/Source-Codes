int main()
{
	int signX = 1;
	int signY = 1;
	int incrementor = 5;
	float x2 = 0.0f;
	float y2 = 0.0f;
	float angleX = 0.0f, angleY = 0.0f, angleZ = 0.0f;
	float angleIncrement = 0.09f;
	float colorA = 0;
	float size = 10.0f;

	while (true) {
		HDC hdc = GetDC(0);
		int x = GetSystemMetrics(SM_CXSCREEN);
		int y = GetSystemMetrics(SM_CYSCREEN);

		x2 += incrementor * signX;
		y2 += incrementor * signY;

		if (x2 + 1 >= x) {
			signX = -11;
			x2 = x - 11;
		}
		else if (x2 <= 1) {
			signX = 11;
			x2 = 11;
		}

		if (y2 + 1 >= y) {
			signY = -11;
			y2 = y - 11;
		}
		else if (y2 <= 1) {
			signY = 11;
			y2 = 11;
		}

		Point3D center = { x2, y2, 88.78f };
		Draw3DCube(hdc, center, size, angleX, angleY, angleZ, colorA);

		angleX += angleIncrement;
		angleY += angleIncrement;
		angleZ += angleIncrement;

		Sleep(10);

		ReleaseDC(0, hdc);
		colorA += 1;

		if (size >= 0 && size <= 10) {
			size += 10;
		}
	}

	return 0;
}
