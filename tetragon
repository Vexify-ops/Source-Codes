#include <windows.h>
#pragma comment(lib, "winmm.lib")
#define _USE_MATH_DEFINES 1
#include <cmath>
#define M_PI 3.14159265358979323846264338327950288

int red, green, blue;
bool ifcolorblue = false, ifblue = false;

COLORREF Hue(int length) {
    if (red != length) {
        red < length; red++;
        if (ifblue == true) {
            return RGB(red, 0, length);
        }
        else {
            return RGB(red, 0, 0);
        }
    }
    else {
        if (green != length) {
            green < length; green++;
            return RGB(length, green, 0);
        }
        else {
            if (blue != length) {
                blue < length; blue++;
                return RGB(0, length, blue);
            }
            else {
                red = 0; green = 0; blue = 0;
                ifblue = true;
            }
        }
    }
}

int main()
{
    int radius = 50;
    while (1) {
        POINT p;
        GetCursorPos(&p);
        int centerX = p.x;
        int centerY = p.y;
        POINT tetragonPoints[4];
        for (int i = 0; i < 4; ++i) {
            double angle = 2.0 * M_PI * i / 4;
            tetragonPoints[i].x = centerX + static_cast<int>(radius * cos(angle));
            tetragonPoints[i].y = centerY + static_cast<int>(radius * sin(angle));
        }

        HBRUSH brush = CreateSolidBrush(Hue(239));
        HDC hdc = GetDC(0);
        SelectObject(hdc, brush);
        Polygon(hdc, tetragonPoints, 4);
        Sleep(10);
        DeleteObject(brush);
        ReleaseDC(0, hdc);
    }
}
