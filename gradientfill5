#include <windows.h>
#pragma comment(lib, "winmm.lib")
#define _USE_MATH_DEFINES 1
#include <cmath>
#define M_PI 3.14159265358979323846264338327950288
#pragma comment(lib, "msimg32.lib")

int main()
{
    HDC hdc = GetDC(0);
    int w = GetSystemMetrics(0);
    int h = GetSystemMetrics(1);
    while (1)
    {
        hdc = GetDC(0);
        TRIVERTEX vertex[3];
        vertex[0].x = rand() % w;
        vertex[0].y = rand() % h;
        vertex[0].Red = rand() % 0xff00;
        vertex[0].Green = rand() % 0xff00;
        vertex[0].Blue = rand() % 0xff00;
        vertex[0].Alpha = rand() % 0xff00;
        vertex[1].x = rand() % w;
        vertex[1].y = rand() % h;
        vertex[1].Red = 0;
        vertex[1].Green = rand() % 0xff00;
        vertex[1].Blue = rand() % 0xff00;
        vertex[1].Alpha = rand() % 0xff00;
        vertex[2].x = rand() % w;
        vertex[2].y = rand() % h;
        vertex[2].Red = rand() % 0xff00;
        vertex[2].Green = rand() % 0xff00;
        vertex[2].Blue = rand() % 0xff00;
        vertex[2].Alpha = rand() % 0xff00;
        GRADIENT_TRIANGLE gTriangle;
        gTriangle.Vertex1 = 0;
        gTriangle.Vertex2 = 1;
        gTriangle.Vertex3 = 2;
        GradientFill(hdc, vertex, 3, &gTriangle, 1, GRADIENT_FILL_TRIANGLE);
        ReleaseDC(0, hdc);
        Sleep(10);
    }
    return 0x00;
}
