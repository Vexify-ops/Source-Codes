#include <windows.h>
#pragma comment(lib, "winmm.lib")
#define _USE_MATH_DEFINES 1
#include <cmath>
#define M_PI 3.14159265358979323846264338327950288

int red = 0, green = 0, blue = 0;
bool ifcolorblue = false, ifblue = false;

COLORREF Hue(int length) {
    if (red != length) {
        red++;
        if (ifblue == true) {
            return RGB(red, 0, length);
        } else {
            return RGB(red, 0, 0);
        }
    } else {
        if (green != length) {
            green++;
            return RGB(length, green, 0);
        } else {
            if (blue != length) {
                blue++;
                return RGB(0, length, blue);
            } else {
                red = 0; green = 0; blue = 0;
                ifblue = true;
            }
        }
    }
}


int main() {
    int w = GetSystemMetrics(SM_CXSCREEN), h = GetSystemMetrics(SM_CYSCREEN);
    HDC hdc;
    HBRUSH hbsh;
    POINT cursorPos;
    int incrementation = 10;

    while (1) {
        // Get the current cursor position
        GetCursorPos(&cursorPos);

        // Get device context for the screen
        hdc = GetDC(0);

        // Use cursor position as the center of the pie
        int x = cursorPos.x - 50;  // Offset the center a bit
        int y = cursorPos.y - 50;

        // Create the brush with a color based on the Hue function
        hbsh = CreateSolidBrush(Hue(259));
        SelectObject(hdc, hbsh);

        // Draw the pie (we're using Pie instead of Ellipse)
        Pie(hdc, x, y, x + 100, y + 100, rand() % w, rand() % h, 30, 30);

        // Clean up the brush
        DeleteObject(hbsh);
        ReleaseDC(0, hdc);

        // Sleep for 10ms to make it smooth
        Sleep(10);
    }

    return 0;
}
